





import autogen
from myfinrobot.utils import get_current_date, register_keys_from_json
from myfinrobot.agents.workflow import SingleAssistant





# Read OpenAI API keys from a JSON file
llm_config = {
    "config_list": autogen.config_list_from_json(
        "../OAI_CONFIG_LIST",
        filter_dict={"model": ["qwen-turbo"]},
    ),
    "timeout": 120,
    "temperature": 0,
}

# Register FINNHUB API keys
register_keys_from_json("../config_api_keys")








company = "Chubb"

assitant = SingleAssistant(
    "Market_Analyst",
    llm_config,
    # set to "ALWAYS" if you want to chat instead of simply receiving the prediciton
    human_input_mode="NEVER",
)

assistant.chat(
    f"使用所有可用工具检索截至{get_current_date()}关于{company}的信息。"
    "分别分析{company}的积极进展和潜在风险，"
    "各列举2-4个最重要因素并保持简洁（多数因素需从公司相关新闻中推断）。"
    f"随后对{company}下周股价走势进行粗略预测（例如：上涨/下跌2-3%），"
    "并提供支持预测的总结性分析。"
)



