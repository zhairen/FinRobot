from finrobot.agents.engine.agent_engine import AgentEngine, Task
from finrobot.agents.factories import (
    DataAnalysisFactory,
    TradingStrategyFactory,
    FinRobotFactory
)
from finrobot.agents.engine.model_gateways import OpenAIGateway, AnthropicGateway

# 初始化Agent引擎
engine = AgentEngine()

# 注册模型网关
engine.register_model("openai", OpenAIGateway())
engine.register_model("anthropic", AnthropicGateway())

# 注册代理工厂
engine.register_agent_factory("data_analysis", DataAnalysisFactory())
engine.register_agent_factory("trading_strategy", TradingStrategyFactory())
engine.register_agent_factory("finrobot", FinRobotFactory())

# 创建数据分析任务
analysis_task = Task(
    type="data_analysis",
    parameters={
        "dataset": "stock_prices",
        "timeframe": "1y",
        "model_config": {"model": "gpt-4"}
    },
    model_type="openai"
)

# 执行任务
result = engine.execute_task(analysis_task)
print(f"分析结果: {result}")

# 创建FinRobot任务
finrobot_task = Task(
    type="finrobot",
    parameters={
        "agent_config": "Expert_Investor",
        "message": "分析AAPL的年度财务报告",
        "retrieve_config": {"sources": ["SEC", "年报"]}
    },
    model_type="anthropic"
)

# 执行任务
report = engine.execute_task(finrobot_task)
print(f"生成的报告: {report}")